# --- RoadPulse backend env ---
# Port for Express API
PORT=8080
# Where the SQLite file lives (default: backend/roadpulse.db)
SQLITE_PATH=./roadpulse.db
# Comma-separated allowed origins for CORS (Vite dev + preview)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: live LLM work orders via OpenRouter (else offline template)
# OPENROUTER_KEY=sk-or-v1-xxxx
